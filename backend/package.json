{
  "name": "@nyumbapap/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed-local.ts",
    "db:migrate-data": "tsx scripts/migrate-postgres-to-mongodb.ts",
    "db:migrate-email-auth": "tsx scripts/migrate-email-auth.ts",
    "db:setup": "prisma db push && tsx scripts/setup-mongodb.ts"
  },
  "dependencies": {
    "@nyumbapap/contracts": "0.1.0",
    "@aws-sdk/client-s3": "^3.637.0",
    "@prisma/client": "^5.19.1",
    "@sentry/nextjs": "^10.69.0",
    "dotenv": "^16.6.1",
    "mongodb": "^7.5.0",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.19.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
