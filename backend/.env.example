# Public application URLs
APP_URL=https://nyumba-pap-bew3p.deployments.nisoko.co.ke
FRONTEND_URL=https://nyumba-pap-frontend-phavm.deployments.nisoko.co.ke
FRONTEND_URLS=https://nyumba-pap-frontend-phavm.deployments.nisoko.co.ke,http://localhost:3000,http://127.0.0.1:3000,https://your-device.your-tailnet.ts.net
DATABASE_URL=mongodb://127.0.0.1:27018/nyumbapap?replicaSet=rs0
# Only needed during a one-time migration from an existing PostgreSQL deployment:
POSTGRES_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/nyumbapap?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_HMAC_SECRET=replace-with-a-separate-at-least-32-character-secret
FIELD_ENCRYPTION_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key

# Safaricom Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://nyumba-pap-bew3p.deployments.nisoko.co.ke/api/webhooks/mpesa
MPESA_BASE_URL_SANDBOX=https://sandbox.safaricom.co.ke
MPESA_BASE_URL_PRODUCTION=https://api.safaricom.co.ke

# Nisoko Email Service. Keep keys and webhook secrets in the deployment secret store.
NES_API_URL=https://nes.nisoko.co.ke
NES_API_KEY=
NES_SECURITY_FROM=security@odafood.com
NES_SUPPORT_FROM=support@odafood.com
NES_BILLING_FROM=billing@odafood.com
NES_WEBHOOK_SECRET=

# Nisoko Object Storage for public listing/interior images. Keep the key server-side.
NISOKO_STORAGE_API_URL=https://storage.nisoko.co.ke
NISOKO_STORAGE_API_KEY=
NISOKO_STORAGE_CONTAINER=nyumba-pap-assets

TENANT_UNLOCK_FEE_KES=100
LISTING_PUBLICATION_FEE_KES=500
LIFECYCLE_JOB_SECRET=replace-with-at-least-32-random-characters
